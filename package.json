{
  "name": "base",
  "version": "0.1.0",
  "scripts": {
    "start": "NG_BUILD_MAX_WORKERS=1 NG_BUILD_PARALLEL_TS=0 ng serve",
    "build": "ng build",
    "test": "ng test --watch=false",
    "format": "prettier --check \"src/**/*.{ts,html,scss}\"",
    "format:fix": "prettier --write \"src/**/*.{ts,html,scss}\"",
